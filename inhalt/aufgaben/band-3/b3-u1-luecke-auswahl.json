  "transkript": [
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Alors, Jonas, qu’est-ce qui est différent chez toi, en Allemagne ?",
      "von": 0.6,
      "bis": 4.52
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "L’école, surtout ! Chez moi, les cours finissent à une heure ou à deux heures. Ici, les journées sont beaucoup plus longues.",
      "von": 4.97,
      "bis": 11.25
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Oui, mais nous, on a une vraie pause à midi.",
      "von": 11.7,
      "bis": 14.34
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "C’est vrai. Et la cantine est meilleure que chez nous ! Hier, j’ai mangé un poisson délicieux.",
      "von": 14.79,
      "bis": 20.51
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Ha ha, tu es le premier à dire ça !",
      "von": 20.96,
      "bis": 23.07
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Par contre, ici, le dîner est très tard. Chez moi, on mange à six heures et demie. Ici, à huit heures ! Le premier soir, j’ai eu très faim !",
      "von": 23.52,
      "bis": 31.48
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Et ta ville ? Elle est plus grande que Montpellier ?",
      "von": 31.93,
      "bis": 34.73
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Non, j’habite près de Brême, dans une petite ville. C’est beaucoup moins grand que Montpellier.",
      "von": 35.18,
      "bis": 40.18
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Et le temps ?",
      "von": 40.63,
      "bis": 41.5
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Alors là, pas de comparaison. Ici, il fait beaucoup plus chaud. En novembre, chez moi, il pleut tout le temps !",
      "von": 41.95,
      "bis": 47.59
    }
  ],
