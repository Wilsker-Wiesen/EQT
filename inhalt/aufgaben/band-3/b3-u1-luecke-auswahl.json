  "transkript": [
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Alors, Jonas, qu’est-ce qui est différent chez toi, en Allemagne ?",
      "von": 0.6,
      "bis": 4.41
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "L’école, surtout ! Chez moi, les cours finissent à une heure ou à deux heures. Ici, les journées sont beaucoup plus longues.",
      "von": 4.86,
      "bis": 12.66
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Oui, mais nous, on a une vraie pause à midi.",
      "von": 13.11,
      "bis": 15.93
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "C’est vrai. Et la cantine est meilleure que chez nous ! Le poisson d’hier était délicieux.",
      "von": 16.38,
      "bis": 24.24
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Ha ha, tu es le premier à dire ça !",
      "von": 24.69,
      "bis": 26.79
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Par contre, ici, le dîner est très tard. Chez moi, on mange à six heures et demie. Ici, à huit heures ! Le premier soir, j’avais trop faim.",
      "von": 27.24,
      "bis": 37.83
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Et ta ville ? Elle est plus grande que Montpellier ?",
      "von": 38.28,
      "bis": 41.09
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Non, j’habite près de Brême, dans une petite ville. C’est beaucoup moins grand que Montpellier.",
      "von": 41.54,
      "bis": 46.54
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Et le temps ?",
      "von": 46.99,
      "bis": 47.88
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Alors là, pas de comparaison. Ici, il fait beaucoup plus chaud. En novembre, chez moi, il pleut tout le temps !",
      "von": 48.33,
      "bis": 57.13
    }
  ],
