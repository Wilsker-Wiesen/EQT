  "transkript": [
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Jonas, ça va ? Tu ne dis rien depuis ce matin.",
      "von": 0.6,
      "bis": 3.93
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Bof… Ça ne va pas trop. J’ai un peu le mal du pays.",
      "von": 4.38,
      "bis": 8.02
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Ah… Ta famille te manque ?",
      "von": 8.47,
      "bis": 9.9
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Oui, surtout ma petite sœur. Et mon chien aussi ! Hier soir, j’ai appelé mes parents, et après, j’étais triste.",
      "von": 10.35,
      "bis": 17.67
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Je comprends. Moi, l’année dernière, j’ai fait un échange en Allemagne. Au début, c’était pareil. La première semaine, c’était difficile.",
      "von": 18.12,
      "bis": 26.75
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Et après ?",
      "von": 27.2,
      "bis": 28.76
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Après, c’était la meilleure expérience de ma vie ! Ne t’en fais pas, c’est normal.",
      "von": 29.21,
      "bis": 33.87
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Tu as raison. Et puis, je fais des progrès en français, non ?",
      "von": 34.32,
      "bis": 37.72
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Oui, beaucoup ! Au début, tu ne parlais presque pas. Maintenant, tu parles tout le temps !",
      "von": 38.17,
      "bis": 43.89
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Ha ha ! Bon. Qu’est-ce qu’on fait ce soir ?",
      "von": 44.34,
      "bis": 47.98
    },
    {
      "audio": 0,
      "sprecher": "ines",
      "text": "Mes copains organisent une petite fête. Tu viens ?",
      "von": 48.43,
      "bis": 51.21
    },
    {
      "audio": 0,
      "sprecher": "jonas",
      "text": "Oui, d’accord. Ça va me faire du bien.",
      "von": 51.66,
      "bis": 54.18
    }
  ],
